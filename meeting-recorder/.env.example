# Copy to .env and fill in. Never commit .env.

# Whisper transcription through the OpenAI API
OPENAI_API_KEY=
# whisper-1 returns timestamps; gpt-4o-transcribe is also accepted (no timestamps)
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Report writing through OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Any OpenRouter chat model with a 32k+ context window
OPENROUTER_MODEL=google/gemini-2.5-flash

# openai (default) or local (needs: pip install faster-whisper)
TRANSCRIBER=openai
LOCAL_WHISPER_MODEL=small

MAX_RECORDING_MINUTES=60
MAX_UPLOAD_MB=200
