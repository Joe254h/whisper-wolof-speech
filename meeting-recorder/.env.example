# Copy to .env and fill in. Never commit .env.

# --- Transcription: pick ONE provider -------------------------------------
# Groq runs the open-source Whisper large-v3 model. It has a free tier and is
# about 3x cheaper than OpenAI when paid. Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3

# OpenAI Whisper (paid, about $0.36 per hour of audio)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# groq, openai or local. Leave empty to use Groq when GROQ_API_KEY is set.
# local runs Whisper on this computer: free, but slow without a GPU
# (needs: pip install faster-whisper)
TRANSCRIBER=
LOCAL_WHISPER_MODEL=small

# Report writing through OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Any OpenRouter chat model with a 32k+ context window
OPENROUTER_MODEL=google/gemini-2.5-flash


MAX_RECORDING_MINUTES=60
MAX_UPLOAD_MB=1024
# Pieces sent to Whisper at the same time (lower it if OpenAI returns rate-limit errors)
TRANSCRIBE_PARALLEL=6
